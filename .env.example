# ── REQUIRED ─────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# PostgreSQL connection string
# Heroku:  heroku addons:create heroku-postgresql  (auto-sets DATABASE_URL)
# Railway: add a PostgreSQL plugin  (auto-sets DATABASE_URL)
# Local:   postgresql://user:password@localhost:5432/hotel85
DATABASE_URL=postgresql://user:password@localhost:5432/hotel85

# Unique slug for this hotel's PostgreSQL schema — no spaces, lowercase.
# e.g. hotel85, kings_inn, grand_hotel_lagos
# Each hotel deployment must have a different value pointing to the shared DB.
# EXISTING DEPLOYMENT: run scripts/migrate_to_schema.py first, then set this.
HOTEL_SCHEMA=hotel85

# ── ACCESS CONTROL ────────────────────────────────────────────────────
# Your single Telegram user ID — the ONLY person who can /addhotel,
# /suspend, /unsuspend, /hotels. Find your ID via @userinfobot on Telegram.
OWNER_ID=123456789

# Comma-separated Telegram user IDs for hotel85 hotel admins.
# These people can manage hotel85 operations but NOT owner-level commands.
ADMIN_IDS=123456789

# ── OPTIONAL ──────────────────────────────────────────────────────────
# Chat ID (or group ID) that receives the automated daily report
# Leave blank to disable scheduled reports
REPORT_CHAT_ID=

# Hotel name shown in reports (overridden by /setup — leave blank for new hotels)
HOTEL_NAME=

# Time for daily automated report (24-hour HH:MM)
DAILY_REPORT_TIME=23:00

# Timezone for scheduled report (IANA format — overridden by /setup)
TIMEZONE=Africa/Lagos

# Default low-stock alert threshold (units)
LOW_STOCK_DEFAULT=5

# ── BACKUPS (optional) ────────────────────────────────────────────────
# Backblaze B2 credentials for scripts/backup.py
# Leave blank to store backups locally only
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
